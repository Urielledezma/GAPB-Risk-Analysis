# --- R / RStudio -------------------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Renviron

# --- Credentials -------------------------------------------------------------
# Never commit. Copy .env.example -> .env and fill it in locally.
.env
.env.*
!.env.example

# --- renv (ignore the library, keep the lockfile) ----------------------------
renv/library/
renv/local/
renv/staging/
renv/sandbox/
renv/python/

# --- Quarto ------------------------------------------------------------------
.quarto/
/.quarto/
*_cache/
/reports/*_files/
/paper/*_files/

# --- Data --------------------------------------------------------------------
# Three tiers, and the tier is decided by the licence of the source, not by how
# far the data has been processed.
#
#   data/raw/       untouched vendor extracts. Never tracked.
#   data/private/   datasets DERIVED from a vendor whose licence forbids
#                   redistribution. Never tracked. This is what the reports read
#                   when a FactSet key is present.
#   data/processed/ datasets derived exclusively from public sources. TRACKED,
#                   deliberately, so the repository renders for anyone.
data/raw/*
!data/raw/.gitkeep
data/private/*
!data/private/.gitkeep
!data/private/README.md

# --- Generated artefacts -----------------------------------------------------
outputs/*
!outputs/.gitkeep

# --- OS / editors ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
~$*

# RStudio rewrites this file whenever the project is opened.
Analisis-de-Riesgo.Rproj
