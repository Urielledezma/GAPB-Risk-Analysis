+<span id="cb34-9"><a href="#cb34-9" aria-hidden="true" tabindex="-1"></a>sma <span class="ot">&lt;-</span> <span class="cf">function</span>(x, m) <span class="fu">as.numeric</span>(stats<span class="sc">::</span><span class="fu">filter</span>(x, <span class="fu">rep</span>(<span class="dv">1</span> <span class="sc">/</span> m, m), <span class="at">sides =</span> <span class="dv">1</span>))</span>
+<span id="cb34-10"><a href="#cb34-10" aria-hidden="true" tabindex="-1"></a></span>
+<span id="cb34-11"><a href="#cb34-11" aria-hidden="true" tabindex="-1"></a><span class="co"># Pronóstico de la varianza del día t: promedio de los m r^2 anteriores</span></span>
+<span id="cb34-12"><a href="#cb34-12" aria-hidden="true" tabindex="-1"></a><span class="co"># (desplazado un día para no usar el rendimiento del propio día)</span></span>
+<span id="cb34-13"><a href="#cb34-13" aria-hidden="true" tabindex="-1"></a>pron_ma <span class="ot">&lt;-</span> <span class="fu">sapply</span>(ventanas_ma, <span class="cf">function</span>(m) <span class="fu">c</span>(<span class="cn">NA</span>, <span class="fu">head</span>(<span class="fu">sma</span>(r2_ma, m), <span class="sc">-</span><span class="dv">1</span>)))</span>
+<span id="cb34-14"><a href="#cb34-14" aria-hidden="true" tabindex="-1"></a></span>
+<span id="cb34-15"><a href="#cb34-15" aria-hidden="true" tabindex="-1"></a><span class="co"># Corte 70 / 30</span></span>
+<span id="cb34-16"><a href="#cb34-16" aria-hidden="true" tabindex="-1"></a>corte_ma  <span class="ot">&lt;-</span> <span class="fu">floor</span>(train_share <span class="sc">*</span> n_ma)</span>
+<span id="cb34-17"><a href="#cb34-17" aria-hidden="true" tabindex="-1"></a>prueba_ma <span class="ot">&lt;-</span> (corte_ma <span class="sc">+</span> <span class="dv">1</span>)<span class="sc">:</span>n_ma</span>
+<span id="cb34-18"><a href="#cb34-18" aria-hidden="true" tabindex="-1"></a></span>
+<span id="cb34-19"><a href="#cb34-19" aria-hidden="true" tabindex="-1"></a><span class="co"># Pérdidas de cada ventana en la parte de prueba</span></span>
+<span id="cb34-20"><a href="#cb34-20" aria-hidden="true" tabindex="-1"></a>perdidas_ma <span class="ot">&lt;-</span> <span class="fu">t</span>(<span class="fu">sapply</span>(<span class="fu">seq_along</span>(ventanas_ma), <span class="cf">function</span>(k) {</span>
+<span id="cb34-21"><a href="#cb34-21" aria-hidden="true" tabindex="-1"></a>  real  <span class="ot">&lt;-</span> r2_ma[prueba_ma]</span>
+<span id="cb34-22"><a href="#cb34-22" aria-hidden="true" tabindex="-1"></a>  pr    <span class="ot">&lt;-</span> pron_ma[prueba_ma, k]</span>
+<span id="cb34-23"><a href="#cb34-23" aria-hidden="true" tabindex="-1"></a>  razon <span class="ot">&lt;-</span> pr <span class="sc">/</span> real</span>
+<span id="cb34-24"><a href="#cb34-24" aria-hidden="true" tabindex="-1"></a>  <span class="fu">c</span>(<span class="at">RMSE     =</span> <span class="fu">sqrt</span>(<span class="fu">mean</span>((real <span class="sc">-</span> pr)<span class="sc">^</span><span class="dv">2</span>)),</span>
+<span id="cb34-25"><a href="#cb34-25" aria-hidden="true" tabindex="-1"></a>    <span class="at">MAE      =</span> <span class="fu">mean</span>(<span class="fu">abs</span>(real <span class="sc">-</span> pr)),</span>
+<span id="cb34-26"><a href="#cb34-26" aria-hidden="true" tabindex="-1"></a>    <span class="at">QLIKE    =</span> <span class="fu">mean</span>((razon <span class="sc">-</span> <span class="fu">log</span>(razon) <span class="sc">-</span> <span class="dv">1</span>)[real <span class="sc">&gt;</span> <span class="dv">0</span>]),  <span class="co"># sin r = 0</span></span>
+<span id="cb34-27"><a href="#cb34-27" aria-hidden="true" tabindex="-1"></a>    <span class="at">Relativo =</span> <span class="fu">mean</span>(<span class="fu">abs</span>(<span class="dv">1</span> <span class="sc">-</span> real <span class="sc">/</span> pr)))</span>
+<span id="cb34-28"><a href="#cb34-28" aria-hidden="true" tabindex="-1"></a>}))</span>
+<span id="cb34-29"><a href="#cb34-29" aria-hidden="true" tabindex="-1"></a><span class="fu">rownames</span>(perdidas_ma) <span class="ot">&lt;-</span> <span class="fu">paste0</span>(<span class="st">"M"</span>, ventanas_ma)</span></code><button title="Copiar al portapapeles" class="code-copy-button"><i class="bi"></i></button></pre></div>
+</details>
+</div>
+<div class="cell" data-layout-align="center">
+<details class="code-fold">
+<summary>Ver código</summary>
+<div class="sourceCode cell-code" id="cb35"><pre class="sourceCode r code-with-copy"><code class="sourceCode r"><span id="cb35-1"><a href="#cb35-1" aria-hidden="true" tabindex="-1"></a><span class="co"># Cada pérdida vota por su ventana ganadora; gana la de más votos.</span></span>
+<span id="cb35-2"><a href="#cb35-2" aria-hidden="true" tabindex="-1"></a><span class="co"># En caso de empate, la de menor RMSE (criterio de clase).</span></span>
+<span id="cb35-3"><a href="#cb35-3" aria-hidden="true" tabindex="-1"></a>ganadoras_ma <span class="ot">&lt;-</span> ventanas_ma[<span class="fu">apply</span>(perdidas_ma, <span class="dv">2</span>, which.min)]</span>
+<span id="cb35-4"><a href="#cb35-4" aria-hidden="true" tabindex="-1"></a>votos_ma     <span class="ot">&lt;-</span> <span class="fu">table</span>(<span class="fu">factor</span>(ganadoras_ma, <span class="at">levels =</span> ventanas_ma))</span>
+<span id="cb35-5"><a href="#cb35-5" aria-hidden="true" tabindex="-1"></a>empate_ma    <span class="ot">&lt;-</span> ventanas_ma[<span class="fu">as.vector</span>(votos_ma) <span class="sc">==</span> <span class="fu">max</span>(votos_ma)]</span>
+<span id="cb35-6"><a href="#cb35-6" aria-hidden="true" tabindex="-1"></a>m_elegida    <span class="ot">&lt;-</span> empate_ma[<span class="fu">which.min</span>(perdidas_ma[<span class="fu">paste0</span>(<span class="st">"M"</span>, empate_ma), <span class="st">"RMSE"</span>])]</span>
+<span id="cb35-7"><a href="#cb35-7" aria-hidden="true" tabindex="-1"></a></span>
+<span id="cb35-8"><a href="#cb35-8" aria-hidden="true" tabindex="-1"></a><span class="co"># Pronóstico de cada ventana para la sesión siguiente y el de la elegida</span></span>
+<span id="cb35-9"><a href="#cb35-9" aria-hidden="true" tabindex="-1"></a>vol_ma       <span class="ot">&lt;-</span> <span class="fu">sapply</span>(ventanas_ma, <span class="cf">function</span>(m) <span class="fu">sqrt</span>(<span class="fu">mean</span>(<span class="fu">tail</span>(r_ma, m)<span class="sc">^</span><span class="dv">2</span>)))</span>
+<span id="cb35-10"><a href="#cb35-10" aria-hidden="true" tabindex="-1"></a>vol_dia_ma   <span class="ot">&lt;-</span> <span class="fu">sqrt</span>(<span class="fu">mean</span>(<span class="fu">tail</span>(r_ma, m_elegida)<span class="sc">^</span><span class="dv">2</span>))</span>
+<span id="cb35-11"><a href="#cb35-11" aria-hidden="true" tabindex="-1"></a>vol_anual_ma <span class="ot">&lt;-</span> <span class="fu">sqrt</span>(trading_days) <span class="sc">*</span> vol_dia_ma</span>
+<span id="cb35-12"><a href="#cb35-12" aria-hidden="true" tabindex="-1"></a></span>
+<span id="cb35-13"><a href="#cb35-13" aria-hidden="true" tabindex="-1"></a><span class="co"># Simulación como en clase: rendimientos del día siguiente</span></span>
+<span id="cb35-14"><a href="#cb35-14" aria-hidden="true" tabindex="-1"></a><span class="fu">use_seed</span>()</span>
+<span id="cb35-15"><a href="#cb35-15" aria-hidden="true" tabindex="-1"></a>sim_ma  <span class="ot">&lt;-</span> <span class="fu">rnorm</span>(config<span class="sc">$</span>gbm<span class="sc">$</span>n_paths, <span class="at">mean =</span> <span class="fu">mean</span>(r_ma), <span class="at">sd =</span> vol_dia_ma)</span>
+<span id="cb35-16"><a href="#cb35-16" aria-hidden="true" tabindex="-1"></a>p_up_ma <span class="ot">&lt;-</span> <span class="fu">mean</span>(sim_ma <span class="sc">&gt;</span> <span class="dv">0</span>)</span>
+<span id="cb35-17"><a href="#cb35-17" aria-hidden="true" tabindex="-1"></a></span>
+<span id="cb35-18"><a href="#cb35-18" aria-hidden="true" tabindex="-1"></a><span class="co"># Comprobación cruzada contra el procedimiento diario del anexo</span></span>
+<span id="cb35-19"><a href="#cb35-19" aria-hidden="true" tabindex="-1"></a><span class="fu">stopifnot</span>(m_elegida <span class="sc">==</span> ma_last<span class="sc">$</span>chosen,</span>
+<span id="cb35-20"><a href="#cb35-20" aria-hidden="true" tabindex="-1"></a>          <span class="fu">isTRUE</span>(<span class="fu">all.equal</span>(vol_dia_ma, ma_last<span class="sc">$</span>vol_chosen)))</span></code><button title="Copiar al portapapeles" class="code-copy-button"><i class="bi"></i></button></pre></div>
+</details>
+</div>
+<div class="cell" data-layout-align="center">
+<details class="code-fold">
+<summary>Ver código</summary>
+<div class="sourceCode cell-code" id="cb36"><pre class="sourceCode r code-with-copy"><code class="sourceCode r"><span id="cb36-1"><a href="#cb36-1" aria-hidden="true" tabindex="-1"></a><span class="fu">report_table</span>(<span class="fu">data.frame</span>(</span>
+<span id="cb36-2"><a href="#cb36-2" aria-hidden="true" tabindex="-1"></a>  <span class="at">Ventana                  =</span> <span class="fu">rownames</span>(perdidas_ma),</span>
+<span id="cb36-3"><a href="#cb36-3" aria-hidden="true" tabindex="-1"></a>  <span class="st">"RMSE × 10⁴"</span>             <span class="ot">=</span> <span class="fu">num</span>(perdidas_ma[, <span class="st">"RMSE"</span>] <span class="sc">*</span> <span class="fl">1e4</span>, <span class="dv">3</span>),</span>
+<span id="cb36-4"><a href="#cb36-4" aria-hidden="true" tabindex="-1"></a>  <span class="st">"MAE × 10⁴"</span>              <span class="ot">=</span> <span class="fu">num</span>(perdidas_ma[, <span class="st">"MAE"</span>] <span class="sc">*</span> <span class="fl">1e4</span>, <span class="dv">3</span>),</span>
+<span id="cb36-5"><a href="#cb36-5" aria-hidden="true" tabindex="-1"></a>  <span class="at">QLIKE                    =</span> <span class="fu">num</span>(perdidas_ma[, <span class="st">"QLIKE"</span>], <span class="dv">1</span>),</span>
+<span id="cb36-6"><a href="#cb36-6" aria-hidden="true" tabindex="-1"></a>  <span class="at">Relativo                 =</span> <span class="fu">num</span>(perdidas_ma[, <span class="st">"Relativo"</span>], <span class="dv">3</span>),</span>
+<span id="cb36-7"><a href="#cb36-7" aria-hidden="true" tabindex="-1"></a>  <span class="st">"Pérdidas que gana"</span>      <span class="ot">=</span> <span class="fu">as.vector</span>(votos_ma),</span>
+<span id="cb36-8"><a href="#cb36-8" aria-hidden="true" tabindex="-1"></a>  <span class="st">"Volatilidad anualizada"</span> <span class="ot">=</span> <span class="fu">pct</span>(<span class="fu">sqrt</span>(trading_days) <span class="sc">*</span> vol_ma, <span class="dv">1</span>),</span>
+<span id="cb36-9"><a href="#cb36-9" aria-hidden="true" tabindex="-1"></a>  <span class="st">"¿Elegida?"</span>              <span class="ot">=</span> <span class="fu">ifelse</span>(ventanas_ma <span class="sc">==</span> m_elegida, <span class="st">"Sí"</span>, <span class="st">"No"</span>),</span>
+<span id="cb36-10"><a href="#cb36-10" aria-hidden="true" tabindex="-1"></a>  <span class="at">check.names =</span> <span class="cn">FALSE</span></span>
+<span id="cb36-11"><a href="#cb36-11" aria-hidden="true" tabindex="-1"></a>))</span></code><button title="Copiar al portapapeles" class="code-copy-button"><i class="bi"></i></button></pre></div>
 </details>
