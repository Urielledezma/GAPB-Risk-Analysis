-<span id="cb35-2"><a href="#cb35-2" aria-hidden="true" tabindex="-1"></a>forecast_long <span class="ot">&lt;-</span> <span class="fu">do.call</span>(rbind, <span class="fu">lapply</span>(ever_chosen, <span class="cf">function</span>(m) {</span>
-<span id="cb35-3"><a href="#cb35-3" aria-hidden="true" tabindex="-1"></a>  <span class="fu">data.frame</span>(<span class="at">date =</span> ma_daily<span class="sc">$</span>date, <span class="at">window =</span> <span class="fu">paste0</span>(<span class="st">"M"</span>, m),</span>
