# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Resolution order (see R/utils_env.R): the machine-wide file is read first,
# then this project's .env, so a project value overrides the machine-wide one.
# To see exactly which files are searched on this machine, and whether they were
# found:
#
#   Rscript -e "source('R/utils_io.R'); source_lib(); print(env_paths())"
#
# Note that the machine-wide path is NOT resolved through "~". On Windows R
# expands the tilde via R_USER, which frequently points at a OneDrive-synced
# Documents folder -- the wrong directory, and one no secret should ever be
# written to.
#
# None of these are required. All are optional enrichments, and none is needed
# to render the reports from the committed snapshot.

# --- FactSet -----------------------------------------------------------------
# NOT required, and not the production path. ITESO's licence carries no API
# entitlement, so fundamentals come from a manual export: a licensed teammate
# saves files into data/raw/factset/manual/ and analysis/03_ingest_fundamentals.R
# normalises them. Extracts land in data/raw/ and are never committed.
#
# These two variables are read only by the historical probe in
# analysis/00_probe_factset.R, kept for diagnostic reference.
FACTSET_USERNAME_SERIAL=
FACTSET_API_KEY=

# --- Banxico SIE -------------------------------------------------------------
# https://www.banxico.org.mx/SieAPIRest/service/v1/token  (free, instant)
# Used by analysis/02_ingest_macro.R. Without it the series is skipped with a
# message and the run continues. Each teammate should obtain their own.
BANXICO_SIE_TOKEN=

# --- INEGI -------------------------------------------------------------------
# https://www.inegi.org.mx/servicios/api_indicadores.html  (free, instant)
# Used by analysis/02_ingest_macro.R. Same behaviour as Banxico when absent.
INEGI_API_TOKEN=
