# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Resolution order (see R/utils_env.R): ~/.secrets/api.env is read first, then
# this project's .env, so a project value overrides the machine-wide one.
#
# None of these are needed to reproduce the reports. They are only required to
# refresh the datasets from source.

# --- FactSet -----------------------------------------------------------------
# https://developer.factset.com  ->  Create API Key
# The username-serial looks like "jdoe_1234"; the key is the generated secret.
# Only used by analysis/03_ingest_fundamentals.R. Extracts land in data/raw/
# and are never committed.
FACTSET_USERNAME_SERIAL=
FACTSET_API_KEY=

# --- Banxico SIE -------------------------------------------------------------
# https://www.banxico.org.mx/SieAPIRest/service/v1/token  (free, instant)
BANXICO_SIE_TOKEN=

# --- INEGI -------------------------------------------------------------------
# https://www.inegi.org.mx/servicios/api_indicadores.html  (free, instant)
INEGI_API_TOKEN=
